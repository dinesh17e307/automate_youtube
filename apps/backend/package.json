    "googleapis": "^144.0.0",
    "ioredis": "^5.4.2",
    "node-cron": "^3.0.3",
    "openai": "^4.77.0",
    "uuid": "^11.0.5",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
