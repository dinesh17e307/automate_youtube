# Database — use Neon free PostgreSQL: https://neon.tech (no cost)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/kids_youtube?sslmode=require

# Server
PORT=3001
NODE_ENV=development
STORAGE_PATH=./storage

# Free tier mode (shorter videos, inline worker, no Redis)
FREE_TIER=true
SERVE_FRONTEND=true
INLINE_WORKER=true

# Cron security — set a random string, use with cron-job.org
CRON_SECRET=change-me-to-random-string

# CORS — comma-separated allowed frontend origins (required in production)
# For Render free (single service): use your Render URL
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# OpenAI (optional — mock providers used when not set)
OPENAI_API_KEY=

# YouTube API (optional — required for publishing)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/youtube/callback

# Pipeline
MAX_RETRIES=3
