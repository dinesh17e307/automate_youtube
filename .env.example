# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kids_youtube

# Redis
REDIS_URL=redis://localhost:6379

# Server
PORT=3001
NODE_ENV=development
STORAGE_PATH=./storage

# OpenAI (optional — mock providers used when not set)
OPENAI_API_KEY=

# YouTube API (optional — required for publishing)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/youtube/callback

# Pipeline
MAX_RETRIES=3
CRON_DAILY_PIPELINE=0 0 * * *
CRON_ANALYTICS=0 */6 * * *
